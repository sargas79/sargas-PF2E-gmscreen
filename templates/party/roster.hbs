{{#if rows.length}}
<table class="gms-roster">
  <thead>
    <tr>
      <th>{{localize "SARGAS_GMSCREEN.Party.Columns.character"}}</th>
      <th>{{localize "SARGAS_GMSCREEN.Party.Columns.hp"}}</th>
      <th class="num">{{localize "SARGAS_GMSCREEN.Party.Stats.ac"}}</th>
      <th class="num">{{localize "SARGAS_GMSCREEN.Party.Stats.fortitude"}}</th>
      <th class="num">{{localize "SARGAS_GMSCREEN.Party.Stats.reflex"}}</th>
      <th class="num">{{localize "SARGAS_GMSCREEN.Party.Stats.will"}}</th>
      <th class="num">{{localize "SARGAS_GMSCREEN.Party.Stats.perception"}}</th>
      <th>{{localize "SARGAS_GMSCREEN.Party.Columns.dcs"}}</th>
      <th class="num">{{localize "SARGAS_GMSCREEN.Party.Columns.heroPoints"}}</th>
      <th class="gms-conditions-col">{{localize "SARGAS_GMSCREEN.Party.Columns.conditions"}}</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    {{#each rows}}
    <tr data-actor-id="{{id}}" data-drop-actor-id="{{id}}" data-search="{{name}} {{className}}">
      <td>
        <div class="gms-who">
          <img src="{{img}}" alt="">
          <div>
            <strong>{{name}}</strong> <span class="gms-muted">{{className}} {{level}}</span>
            <div class="gms-muted">{{#each speeds}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}{{#if senses.length}} · {{#each senses}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}{{/if}}</div>
          </div>
        </div>
      </td>
      <td class="gms-hp">
        <div class="gms-bar {{hp.state}}" role="meter" aria-valuemin="0" aria-valuemax="{{hp.max}}" aria-valuenow="{{hp.value}}">
          <span style="width: {{hp.percent}}%"></span>
        </div>
        <div class="gms-hp-controls">
          <button type="button" class="icon fa-solid fa-minus" data-action="adjustHp" data-direction="-1"
            data-tooltip="SARGAS_GMSCREEN.Party.HpMinus" aria-label="{{localize 'SARGAS_GMSCREEN.Party.HpMinus'}}"></button>
          <span><strong>{{hp.value}}</strong>/{{hp.max}}{{#if hp.temp}} <span class="gms-muted">+{{hp.temp}}</span>{{/if}}</span>
          <button type="button" class="icon fa-solid fa-plus" data-action="adjustHp" data-direction="1"
            data-tooltip="SARGAS_GMSCREEN.Party.HpPlus" aria-label="{{localize 'SARGAS_GMSCREEN.Party.HpPlus'}}"></button>
        </div>
      </td>
      <td class="num gms-stat">{{ac}}</td>
      <td class="num gms-stat">{{numberFormat saves.fortitude sign=true}}</td>
      <td class="num gms-stat">{{numberFormat saves.reflex sign=true}}</td>
      <td class="num gms-stat">{{numberFormat saves.will sign=true}}</td>
      <td class="num"><span class="gms-stat">{{numberFormat perception.mod sign=true}}</span> <span class="gms-muted">DC {{perception.dc}}</span></td>
      <td class="gms-dcs">
        {{#if classDC}}<div><span class="gms-muted">{{localize "SARGAS_GMSCREEN.Party.ClassDC"}}</span> {{classDC}}</div>{{/if}}
        {{#if spellDC}}<div><span class="gms-muted">{{localize "SARGAS_GMSCREEN.Party.SpellDC"}}</span> {{spellDC}}</div>{{/if}}
      </td>
      <td class="num">{{heroPoints.value}}/{{heroPoints.max}}</td>
      <td class="gms-conditions-col">
        <div class="gms-conditions">
          {{#each conditions}}
          <button type="button" class="gms-condition" data-action="decreaseCondition" data-condition-id="{{id}}"
            data-tooltip="{{name}}{{#if value}} {{value}}{{/if}}" aria-label="{{name}}{{#if value}} {{value}}{{/if}}">
            <img src="{{img}}" alt="">{{#if value}}<span>{{value}}</span>{{/if}}
          </button>
          {{/each}}
        </div>
      </td>
      <td>
        <div class="gms-row-actions">
          <button type="button" class="icon fa-solid fa-id-card" data-action="openSheet"
            data-tooltip="SARGAS_GMSCREEN.Party.OpenSheet" aria-label="{{localize 'SARGAS_GMSCREEN.Party.OpenSheet'}}"></button>
          <button type="button" class="icon fa-solid fa-location-crosshairs" data-action="pingToken"
            data-tooltip="SARGAS_GMSCREEN.Party.Ping" aria-label="{{localize 'SARGAS_GMSCREEN.Party.Ping'}}"></button>
        </div>
      </td>
    </tr>
    {{/each}}
  </tbody>
</table>
<p class="gms-hint">{{localize "SARGAS_GMSCREEN.Party.RosterHint"}}</p>
{{else}}
<p>{{localize "SARGAS_GMSCREEN.Party.Empty"}}</p>
{{/if}}
