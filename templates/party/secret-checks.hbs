<p class="gms-hint">{{localize "SARGAS_GMSCREEN.Party.SecretHint"}}</p>
<div class="gms-inline-form">
  <select name="secretCheck" aria-label="{{localize 'SARGAS_GMSCREEN.Party.Cards.secret-checks'}}">
    {{selectOptions options valueAttr="value" labelAttr="label"}}
  </select>
  <button type="button" data-action="secretCheck" {{disabled disabled}}>
    <i class="fa-solid fa-dice-d20" inert></i> {{localize "SARGAS_GMSCREEN.Party.Roll"}}
  </button>
</div>
