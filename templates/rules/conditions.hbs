{{#if conditions}}
<ul class="gms-chips">
  {{#each conditions}}
  <li data-search="{{name}}" data-tooltip="{{summary}}">
    {{{link}}}{{#if valued}}<span class="gms-badge" aria-label="{{localize 'SARGAS_GMSCREEN.Rules.Valued'}}">X</span>{{/if}}
  </li>
  {{/each}}
</ul>
<p class="gms-hint">{{localize "SARGAS_GMSCREEN.Rules.ConditionsHint"}}</p>
{{else}}
<p class="gms-warning">{{localize "SARGAS_GMSCREEN.Rules.MissingCompendium"}}</p>
{{/if}}
<footer class="gms-card-links">{{{link}}}</footer>
