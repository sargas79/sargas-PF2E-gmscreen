<div class="gms-dc-grid">
  {{#each rows}}
  <div class="gms-dc{{#if highlight}} highlight{{/if}}" data-search="{{level}}"
    aria-label="{{localize 'SARGAS_GMSCREEN.Rules.Level'}} {{level}}: {{localize 'SARGAS_GMSCREEN.Rules.DC'}} {{dc}}">
    <span>{{level}}</span><strong>{{dc}}</strong>
  </div>
  {{/each}}
</div>
<footer class="gms-card-links">{{{link}}}</footer>
