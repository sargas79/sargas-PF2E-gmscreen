<ul class="gms-pairs">
  {{#each simple}}
  <li><span>{{localize (concat "SARGAS_GMSCREEN.Rules.Ranks." rank)}}</span><strong>{{dc}}</strong></li>
  {{/each}}
</ul>
<table>
  <thead>
    <tr>
      <th>{{localize "SARGAS_GMSCREEN.Rules.Difficulty"}}</th>
      <th class="num">{{localize "SARGAS_GMSCREEN.Rules.Adjustment"}}</th>
      <th>{{localize "SARGAS_GMSCREEN.Rules.Rarity"}}</th>
    </tr>
  </thead>
  <tbody>
    {{#each difficulty}}
    <tr>
      <td>{{localize (concat "SARGAS_GMSCREEN.Rules.Difficulties." key)}}</td>
      <td class="num">{{numberFormat adjustment sign=true}}</td>
      <td class="gms-muted">{{#if rarity}}{{localize (concat "SARGAS_GMSCREEN.Rules.Rarities." rarity)}}{{/if}}</td>
    </tr>
    {{/each}}
  </tbody>
</table>
<footer class="gms-card-links">{{#each links}}{{{this}}}{{/each}}</footer>
