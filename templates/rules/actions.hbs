{{#if groups}}
{{#each groups}}
<section class="gms-group">
  <h4>{{label}}</h4>
  <ul class="gms-chips">
    {{#each actions}}
    <li data-search="{{name}}">{{{link}}}{{#if glyph}}<span class="action-glyph">{{glyph}}</span>{{/if}}</li>
    {{/each}}
  </ul>
</section>
{{/each}}
{{else}}
<p class="gms-warning">{{localize "SARGAS_GMSCREEN.Rules.MissingCompendium"}}</p>
{{/if}}
<footer class="gms-card-links">{{{link}}}</footer>
